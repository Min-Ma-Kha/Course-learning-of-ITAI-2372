# EXAMPLE ONLY - this file is safe to upload because it contains no real key.
#
# To use secrets locally (optional - an environment variable also works):
#   1. Copy this file and rename the copy to:  .streamlit/secrets.toml
#   2. Paste your real key below.
# .gitignore already blocks secrets.toml from ever being uploaded to GitHub.
#
# On Streamlit Community Cloud, paste these same lines into
# App settings -> Secrets instead of creating a file.

GEMINI_API_KEY = "paste-your-gemini-api-key-here"

# Optional: choose a different Gemini model
# GEMINI_MODEL = "gemini-3.8-flash"
